# OrbitFS Base — canonical Vercel runtime environment
# This file is the source-of-truth template for automated Base deployments.
# Never commit real secrets. The auto-deployer should populate secret values.

# ---------------------------------------------------------------------------
# REQUIRED — shared OrbitFS Supabase project
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Billing-managed deployments populate this non-secret JSON attestation with the selected
# Supabase project ref plus SHA-256 fingerprints of the validated publishable/server keys.
# The Inner Engine deployer refuses stale/mismatched Billing credentials.
ORBITFS_SUPABASE_CONNECTION_ATTESTATION=
# Separate OrbitFS application secret used for encrypted deployment credentials / Engine fallback.
ORBITFS_DB_SECRET=YOUR_ORBITFS_APPLICATION_SECRET
# Billing Store deployments set this before first boot so Base and Store share one installation identity.
# Standard/self-managed installs leave it empty and Base generates a persistent ofs-* identity.
ORBITFS_INSTALLATION_ID=
# Billing Store deployments set this to billing_store. Standard/self-managed installs use standard.
ORBITFS_INSTALLATION_ROUTE=standard

# ---------------------------------------------------------------------------
# REQUIRED — OrbitFS Panel identity
# ---------------------------------------------------------------------------
# Canonical production Panel URL. Override only when deploying a non-production
# installation and only with a public HTTPS URL.
ORBITFS_PANEL_URL=https://panel.incendiarynetworks.cc

# ---------------------------------------------------------------------------
# REQUIRED FOR LICENSED RUNTIME — License Master V2
# ---------------------------------------------------------------------------
# Canonical public License Master endpoint used by the Base runtime.
ORBITFS_LICENSE_API_URL=https://incendiarynetworks.cc/api/v1/license

# ---------------------------------------------------------------------------
# RELEASE / RUNTIME IDENTITY
# ---------------------------------------------------------------------------
# The release/deployer should set this to the installed Base release version.
# Leave unset only for local development.
ORBITFS_APP_VERSION=
# Optional authoritative release identity supplied by the Base Deployer.
# These fields let the runtime record the exact published release without inventing local authority.
ORBITFS_BASE_RELEASE_ID=
ORBITFS_BASE_SOURCE_COMMIT=
ORBITFS_BASE_RELEASE_SHA256=

# ---------------------------------------------------------------------------
# ENGINE HOST — populated when Engine is provisioned
# ---------------------------------------------------------------------------
ORBITFS_ENGINE_HOST_URL=
ORBITFS_ENGINE_HOST_PREVIEW_URL=
# Use the same secure value on Base and Engine when explicitly configured.
# Base code falls back to ORBITFS_DB_SECRET when this is not supplied.
ORBITFS_ENGINE_SECRET=

# ---------------------------------------------------------------------------
# ENGINE / VERCEL AUTOMATION — optional on first Base install
# ---------------------------------------------------------------------------
ORBITFS_ENGINE_RELEASE_PROVIDER=https://incendiarynetworks.cc/api/v1/updater
# Normal Engine/add-on updates use their own delivery channel, independent of the Base release channel.
ORBITFS_UPDATE_CHANNEL=stable
ORBITFS_ENGINE_RELEASE_TIMEOUT_MS=30000
ORBITFS_VERCEL_TIMEOUT_MS=30000
ORBITFS_ENGINE_PROJECT_PREFIX=orbitfs-engine
ORBITFS_VERCEL_TOKEN=
ORBITFS_VERCEL_TEAM_ID=

# ---------------------------------------------------------------------------
# LICENSE TRANSPORT DEFAULTS
# ---------------------------------------------------------------------------
# Validation TTL, offline grace and pulse polling are supplied by License Manager runtime_policy.
ORBITFS_LICENSE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# BASE RELEASE BUILD DEFAULTS
# ---------------------------------------------------------------------------
ORBITFS_SCHEMA_VERSION=2
ORBITFS_RELEASE_CHANNEL=stable
ORBITFS_PANEL_RELEASE_VERSION=

# ---------------------------------------------------------------------------
# Vercel-provided values — do not manually set these in normal deployments.
# ---------------------------------------------------------------------------
# VERCEL_ENV
# VERCEL_URL
# VERCEL_PROJECT_PRODUCTION_URL
# VERCEL_GIT_COMMIT_REF
# VERCEL_GIT_COMMIT_SHA
# VERCEL_GIT_COMMIT_MESSAGE